{
  "_comment": "Application under test settings. Override per environment via appsettings.{Environment}.json",
  "HeadlessMode": false,
  "BrowserType": "CHROMIUM",
  "CaptureBrowserLogs": false,
  "ViewportSize": {
    "Width": 1152,
    "Height": 648
  },
  "PlaywrightArgs": "--auth-server-allowlist=*.yourdomain.com",
  "UI": {
    "ApplicationUrl": "https://cpfappqa.worldbank.org/",
    "Authentication": {
      "StorageStateDirectory": "playwright/.auth",
      "Users": [
        {
          "Key": "default",
          "Username": "cpfqaautomation@worldbankgroup.org",
          "Password": "PLACEHOLDER_PASSWORD"
        }
      ]
    }
  },
  "DbSettings": {
    "Server": "pg-itsce-common-ouo-qa.postgres.database.azure.com",
    "Port": 5432,
    "Database": [
      {
        "DbName": "cpfappdb",
        "Username": "ITSCE-WBG-CPFAPP-DB-ADMIN-NonProd",
        "Password": "PLACEHOLDER_PASSWORD"
      }
    ],
    "PostgreSql": {
      "EnableSslMode": true,
      "SslMode": "Require",
      "TrustServerCertificate": true
    }
  },
  "Api": {
    "Services": {
      "jsonplaceholder": {
        "BaseUrl": "https://jsonplaceholder.typicode.com"
      },
      "postmanecho": {
        "BaseUrl": "https://postman-echo.com"
      },
      "cpfappqa": {
        "BaseUrl": "https://aas-cpfapp-api.itsesasev3qa.worldbank.org"
      }
    },
    "Logging": {
      "AttachToAllure": true,
      "AttachOnFailureOnly": false,
      "MaxBodySizeBytes": 15000,
      "RedactSensitiveData": false,
      "AdditionalRedactedFields": []
    }
  }
}
