{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "microsoft-learn": {
      "serverUrl": "https://learn.microsoft.com/api/mcp"
    },
    "fff": {
      "command": "C:/Users/georg/AppData/Local/fff-mcp/bin/fff-mcp.exe"
    },
    "codebase-memory-mcp": {
      "command": "C:/Users/georg/AppData/Local/Programs/codebase-memory-mcp/codebase-memory-mcp.exe",
      "args": [],
      "cwd": "C:/GK/Sources/csharp-test-automation-playwright"
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "--prefer-offline",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--no-usage-statistics"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch",
        "--ignore-robots-txt",
        "--user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
