{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "headless": true,
      "slowMo": 0
    },
    "contextOptions": {
      "viewport": {
        "width": 1280,
        "height": 720
      },
      "locale": "en-US",
      "ignoreHTTPSErrors": true
    }
  },
  "timeouts": {
    "action": 6000,
    "navigation": 60000,
    "expect": 6000,
    "settle": 500
  }
}