{
  // ========== EDITOR ==========
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
  "dotnet.defaultSolution": "CsharpTestAutomation.slnx",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2
  },
  // ========== VISUAL GUIDES ==========
  "editor.rulers": [
    120
  ],
  "editor.codeLens": true,
  // ========== FILE NESTING ==========
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.cs": "${basename}.Test.cs, ${basename}Tests.cs",
    "*.csproj": "*.csproj.user",
    "appsettings.json": "appsettings.*.json",
    "NLog.config": "NLog.config.*.xml"
  },
  // ========== SEARCH & EXCLUSIONS ==========
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/TestResults": true,
    "**/allure-results": true,
    "**/Traces": true,
    "**/Videos": true
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  // ========== TESTING ==========
  "testing.gutterEnabled": true,
  // ========== COPILOT / AGENTS ==========
  "chat.useAgentsMdFile": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.hookFilesLocations": {
    ".agents/hooks.json": true
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".agents/instructions/commit-instructions.md"
    }
  ],
  // Reduce unnecessary agent context usage.
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.terminal.outputCompaction": true,
  // ========== TERMINAL AUTO-APPROVE ==========
  // Keep this list narrow. Terminal auto-approval is a convenience,
  // not a security boundary.
  "chat.tools.terminal.autoApprove": {
    "dotnet build": true,
    "dotnet restore": true,
    "dotnet test": true,
    "Group-Object": true,
    "Get-Unique": true,
    "ConvertFrom-Json": true,
    "/^& '?C:\\\\Program Files\\\\dotnet\\\\dotnet\\.exe'? (build|test|restore)\\b/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}