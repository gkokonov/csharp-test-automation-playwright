{
  "servers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CONTEXT7_API_KEY}"
      }
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp?maxTokenBudget=5000"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "--prefer-offline",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--no-usage-statistics"
      ]
    },
    "fff": {
      "type": "stdio",
      "command": "${env:LOCALAPPDATA}/fff-mcp/bin/fff-mcp.exe"
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "${env:LOCALAPPDATA}/Programs/codebase-memory-mcp/codebase-memory-mcp.exe",
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  }
}
